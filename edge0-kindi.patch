diff --git a/macos/crates/engine-native/src/joint_budget.hpp b/macos/crates/engine-native/src/joint_budget.hpp
new file mode 100644
index 0000000..0d3f5b2
--- /dev/null
+++ b/macos/crates/engine-native/src/joint_budget.hpp
@@ -0,0 +1,67 @@
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <vector>
+
+namespace e0n {
+// Tracks live payload ownership, not just entries still present in an LRU.
+// Runtime/allocator/mmap overhead is separately checked by the process guard.
+class JointBudget {
+  struct State {
+    std::mutex mu;
+    uint64_t limit, live = 0, peak = 0, rejected = 0;
+    explicit State(uint64_t n) : limit(n) {}
+  };
+ public:
+  class Lease {
+    friend class JointBudget;
+    std::shared_ptr<State> state_;
+    uint64_t bytes_;
+   public:
+    Lease(std::shared_ptr<State> s, uint64_t n) noexcept : state_(std::move(s)), bytes_(n) {}
+    Lease(const Lease &) = delete;
+    ~Lease() { std::lock_guard<std::mutex> g(state_->mu); state_->live -= bytes_; }
+  };
+  struct Metrics { uint64_t limit, live, peak, rejected; };
+  explicit JointBudget(uint64_t limit) : state_(std::make_shared<State>(limit)) {}
+  // Register once, before worker threads start using the budget. No callback
+  // is invoked with the budget mutex held. Cache eviction must be thread safe.
+  void add_evictor(std::function<bool()> f) { evictors_.push_back(std::move(f)); }
+  std::shared_ptr<Lease> acquire(uint64_t n) {
+    {
+      std::lock_guard<std::mutex> g(state_->mu);
+      if (n > state_->limit) { ++state_->rejected; return {}; }
+    }
+    for (;;) {
+      {
+        std::lock_guard<std::mutex> g(state_->mu);
+        if (n <= state_->limit - state_->live) {
+          auto lease = std::make_shared<Lease>(state_, n);
+          state_->live += n;
+          if (state_->live > state_->peak) state_->peak = state_->live;
+          return lease;
+        }
+      }
+      bool progress = false;
+      for (auto &evict : evictors_) {
+        if (evict()) { progress = true; break; }
+      }
+      if (!progress) {
+        std::lock_guard<std::mutex> g(state_->mu);
+        ++state_->rejected;
+        return {};
+      }
+    }
+  }
+  Metrics metrics() const {
+    std::lock_guard<std::mutex> g(state_->mu);
+    return {state_->limit, state_->live, state_->peak, state_->rejected};
+  }
+ private:
+  std::shared_ptr<State> state_;
+  std::vector<std::function<bool()>> evictors_;
+};
+} // namespace e0n
