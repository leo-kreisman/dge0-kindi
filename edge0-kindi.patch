new file mode 100644
index 0000000..538a065
--- /dev/null
+++ b/macos/crates/engine-native/src/packed_experts.hpp
@@ -0,0 +1,115 @@
+#pragma once
+// Optional local sidecar: byte-exact, expert-major storage. No MLX dependency.
+#include <array>
+#include <cerrno>
+#include <cstdint>
+#include <fstream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <nlohmann/json.hpp>
+
+namespace e0n {
+class PackedExperts {
+ public:
+  static constexpr uint64_t max_expert_bytes = 32ull << 20;
+  struct Source { std::string path, shard; uint64_t begin, end, length; };
+  struct Payload {
+    std::vector<uint32_t> words; // aligned for U32 and BF16 array constructors
+    const uint8_t *data() const { return reinterpret_cast<const uint8_t *>(words.data()); }
+  };
+  PackedExperts() = default;
+  PackedExperts(const PackedExperts &) = delete;
+  ~PackedExperts() { if (fd_ >= 0) ::close(fd_); }
+  uint64_t bytes() const { return bytes_; }
+  static uint32_t crc32(const uint8_t *p, size_t n) {
+    static const auto table = [] {
+      std::array<uint32_t,256> t{};
+      for (uint32_t i=0; i<256; ++i) {
+        uint32_t c=i;
+        for (int b=0; b<8; ++b) c=(c>>1) ^ (0xedb88320u & (0u-(c&1u)));
+        t[i]=c;
+      }
+      return t;
+    }();
+    uint32_t c=~0u;
+    for (size_t i=0; i<n; ++i) c=table[(c^p[i])&255]^(c>>8);
+    return ~c;
+  }
+  static uint64_t mtime_ns(const struct stat &st) {
+#ifdef __APPLE__
+    const auto ts=st.st_mtimespec;
+#else
+    const auto ts=st.st_mtim;
+#endif
+    return uint64_t(ts.tv_sec)*1000000000ull + uint64_t(ts.tv_nsec);
+  }
+  void open(const std::string &dir, int layer, uint64_t experts,
+            const std::array<Source,9> &sources) {
+    if (fd_>=0 || experts==0 || experts>4096) fail("invalid open");
+    const auto stem=dir+"/layer-"+std::to_string(layer);
+    struct stat st{};
+    if (::stat((stem+".json").c_str(), &st) || st.st_size<=0 || st.st_size>(1<<20))
+      fail("missing/oversize index");
+    std::ifstream in(stem+".json");
+    // Read a fixed upper bound even if the file grows after stat.
+    std::string data(size_t(st.st_size), '\0');
+    if (!in.read(data.data(), data.size())) fail("truncated index");
+    auto j=nlohmann::json::parse(data);
+    if (j.at("format")!="edge0-experts-v1" || j.at("layer")!=layer ||
+        j.at("experts")!=experts || j.at("lengths").size()!=9 ||
+        j.at("sources").size()!=9 || j.at("crc32").size()!=experts) fail("index identity");
+    uint64_t total=0;
+    for (size_t i=0; i<9; ++i) {
+      const auto &s=sources[i]; const auto &v=j.at("sources").at(i);
+      if (s.length==0 || s.length>max_expert_bytes-total ||
+          s.end<s.begin || s.end-s.begin!=s.length*experts ||
+          j.at("lengths").at(i)!=s.length || v.at("shard")!=s.shard ||
+          v.at("begin")!=s.begin || v.at("end")!=s.end) fail("tensor layout");
+      if (::stat(s.path.c_str(), &st) || !S_ISREG(st.st_mode) ||
+          st.st_size<0 || s.end>uint64_t(st.st_size) ||
+          v.at("size")!=uint64_t(st.st_size) || v.at("mtime_ns")!=mtime_ns(st))
+        fail("source changed; regenerate sidecar on this machine");
+      total+=s.length;
+    }
+    if (j.at("data_bytes")!=total*experts) fail("payload length");
+    std::vector<uint32_t> crc;
+    for (const auto &v : j.at("crc32")) {
+      if (!v.is_number_unsigned() || v.get<uint64_t>()>UINT32_MAX) fail("checksum range");
+      crc.push_back(v.get<uint32_t>());
+    }
+    const int fd=::open((stem+".bin").c_str(),O_RDONLY|O_CLOEXEC);
+    if (fd<0) fail("missing payload");
+    if (::fstat(fd,&st) || !S_ISREG(st.st_mode) || st.st_size<0 ||
+        uint64_t(st.st_size)!=total*experts) { ::close(fd); fail("payload size"); }
+    fd_=fd; bytes_=total; experts_=experts; checksums_=std::move(crc);
+  }
+  Payload read(uint64_t expert, uint64_t &calls) const {
+    if (fd_<0 || expert>=experts_) fail("expert out of range");
+    Payload p;
+    p.words.resize((bytes_+3)/4);
+    auto *dst=reinterpret_cast<uint8_t *>(p.words.data());
+    uint64_t done=0;
+    while (done<bytes_) {
+      ++calls;
+      const ssize_t n=::pread(fd_,dst+done,bytes_-done,off_t(expert*bytes_+done));
+      if (n<0 && errno==EINTR) continue;
+      if (n<=0) fail("payload read failed/truncated");
+      done+=uint64_t(n);
+    }
+    if (crc32(dst,bytes_)!=checksums_.at(expert)) fail("payload checksum mismatch");
+    return p;
+  }
+ private:
+  [[noreturn]] static void fail(const char *why) {
+    throw std::runtime_error(std::string("packed experts: ")+why);
+  }
+  int fd_=-1;
+  uint64_t bytes_=0, experts_=0;
+  std::vector<uint32_t> checksums_;
+};
