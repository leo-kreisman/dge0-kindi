--- /dev/null
+++ b/macos/crates/engine-native/src/expert_residency.hpp
@@ -0,0 +1,201 @@
+// Bounded demand-frequency residency with optional restart hints. No model training.
+// Original implementation inspired by Strata's decayed usage/ranked-profile design.
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include <nlohmann/json.hpp>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace e0n {
+// Metadata identity, not a cryptographic content hash. Includes adapters/configs
+// alongside shards. Replacing, relocating or touching files invalidates the hint.
+inline std::string residency_identity(const std::string &dir) {
+  namespace fs = std::filesystem;
+  nlohmann::json files = nlohmann::json::object();
+  auto root = fs::canonical(dir);
+  for (const auto &entry : fs::directory_iterator(root)) {
+    if (!entry.is_regular_file()) continue;
+    struct stat st{};
+    if (::stat(entry.path().c_str(), &st)) throw std::runtime_error("profile source stat failed");
+#ifdef __APPLE__
+    auto ns = st.st_mtimespec.tv_nsec;
+#else
+    auto ns = st.st_mtim.tv_nsec;
+#endif
+    files[entry.path().filename().string()] = {st.st_size, st.st_mtime, ns};
+    if (files.size() > 512) throw std::runtime_error("too many profile source files");
+  }
+  std::string identity = nlohmann::json({{"root",root.string()}, {"files",files},
+                                       {"runtime","edge0-85b2a03-residency-v1"}}).dump();
+  if (identity.size() > 65536) throw std::runtime_error("oversize profile identity");
+  return identity;
+}
+
+template<class T> class ExpertResidency {
+ public:
+  explicit ExpertResidency(int slots) : slots_(slots) {}
+  struct Metrics { uint64_t observations=0, adaptive_evictions=0, loaded=0; bool enabled=false; };
+  // Before workers start. A bad explicit profile is rejected without partial import.
+  void configure(bool enabled, const std::map<int,int> &layout,
+                 const std::string &identity, const std::string &path) {
+    if (!enabled && !path.empty()) throw std::runtime_error("profile requires adaptive cache");
+    if (!enabled) return;
+    if (identity.size() > 65536) throw std::runtime_error("oversize identity");
+    std::map<int,Layer> next;
+    size_t total=0;
+    for (auto [li,n] : layout) {
+      if (li<0 || li>65535 || n<1 || n>4096 || (total+=n)>65536)
+        throw std::runtime_error("invalid profile layout");
+      next[li].heat.resize(n);
+    }
+    if (next.empty()) throw std::runtime_error("empty profile layout");
+    uint64_t loaded=0;
+    if (!path.empty() && std::filesystem::exists(path)) {
+      if (!std::filesystem::is_regular_file(path) || std::filesystem::file_size(path)>1048576)
+        throw std::runtime_error("invalid profile file size/type");
+      std::ifstream in(path, std::ios::binary);
+      // Bound the read too: a file growing after file_size must not allocate freely.
+      std::string data(1048577, '\0'); in.read(data.data(),data.size()); data.resize(in.gcount());
+      if (data.size()>1048576) throw std::runtime_error("profile grew beyond limit");
+      nlohmann::json j=nlohmann::json::parse(data, [](int depth,nlohmann::json::parse_event_t,nlohmann::json&){
+        if(depth>8) throw std::runtime_error("profile nesting too deep"); return true;
+      });
+      if (j.at("version")!=1 || j.at("identity")!=identity || j.at("layout")!=layout_json(layout) ||
+          !j.at("heat").is_array() || j.at("heat").size()>total)
+        throw std::runtime_error("incompatible expert profile");
+      std::set<uint64_t> seen;
+      for (const auto &v:j.at("heat")) {
+        if (!v.is_array() || v.size()!=3 || !v[0].is_number_integer() || !v[1].is_number_integer() || !v[2].is_number())
+          throw std::runtime_error("invalid profile row");
+        auto li=v[0].get<int64_t>(), e=v[1].get<int64_t>(); double score=v[2].get<double>();
+        if(li<0 || li>65535 || !next.count(int(li)) || e<0 || e>=int64_t(next.at(int(li)).heat.size()) ||
+           !std::isfinite(score) || score<=0 || score>128 || !seen.insert(key(int(li),e)).second)
+          throw std::runtime_error("invalid profile expert/score");
+        next.at(int(li)).heat[size_t(e)]={score,0}; ++loaded;
+      }
+    }
+    std::lock_guard<std::mutex> lock(mu_);
+    layers_=std::move(next); identity_=identity; path_=path; layout_=layout;
+    enabled_=true; loaded_=loaded;
+  }
+  // Only consumed decode routes call this, including actual prerouter selections.
+  // Prefill, guessed future routes and loading/cache hits never inflate scores.
+  void observe(int li,const std::vector<int64_t> &experts) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (!enabled_) return;
+    auto it=layers_.find(li);
+    if(it==layers_.end()) throw std::runtime_error("unknown observed layer");
