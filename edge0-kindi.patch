+  if (state.position < 0 || uint64_t(state.position) != tokens.size())
+    throw std::runtime_error("checkpoint state/token position mismatch");
+  guard_memory(h);
+  auto m = e0n::mem_sample();
+  const uint64_t used = std::max(m.resident_bytes, m.footprint_bytes);
+  const uint64_t ceiling = h->memory_limit - h->memory_reserve;
+  if (used >= ceiling || bytes > ceiling - used) return;
+  auto admission = h->joint_budget->acquire(bytes);
+  if (!admission) return;  // Optional cache work must not abort inference.
+  auto snap = capture(state, logits);
+  snap->admission = std::move(admission);
+  h->prefix_cache->put(h->model_identity, tokens, snap, bytes, nullptr, !logits.empty());
+}
