+template <class State, class Capture>
+void save_checkpoint(E0Engine *h, const State &state,
+                     const std::vector<int32_t> &tokens,
+                     const std::vector<float> &logits, Capture capture) {
+  // Check before COPY, including token index and a conservative metadata charge.
+  const uint64_t bytes = state_bytes(state) + logits.size() * sizeof(float) +
+                        tokens.size() * sizeof(int32_t) + h->model_identity.size() + 4096;
