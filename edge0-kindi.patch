+// Process measurements are deliberately separate from managed payload bytes.
+// Metal's set_memory_limit is advisory, not an OS-enforced process ceiling.
+void guard_memory(E0Engine *h) {
+  auto m = e0n::mem_sample();
+  if (!m.resident_bytes && !m.footprint_bytes)
+    throw std::runtime_error("memory guard: process memory measurement unavailable");
+  const uint64_t ceiling = h->memory_limit - h->memory_reserve;
+  if (std::max(m.resident_bytes, m.footprint_bytes) < ceiling) return;
+  h->prefix_cache->clear();
+  if (h->net35) h->net35->drop_cached();
+  if (h->net8b) h->net8b->drop_cached();
+  mlx::core::clear_cache();
+  m = e0n::mem_sample();
+  if (std::max(m.resident_bytes, m.footprint_bytes) >= ceiling)
+    throw std::runtime_error("memory guard: request stopped before exhausting 8 GiB budget");
+}
